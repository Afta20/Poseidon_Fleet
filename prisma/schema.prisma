// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Route {
  id      String   @id @default(uuid())
  name    String
  vessels Vessel[]
}

model Vessel {
  id          String   @id @default(uuid())
  name        String
  type        String   // Tanker, Cargo, Passenger
  status      String   // En Route, In Port, Delayed, Maintenance
  plateCode   String?  // Plat Nomor / Kode Kendaraan
  capacity    Float?   // Kapasitas Muatan (Ton)
  payload     String?  // Storage for Cargo/Manifest Description
  logs        Log[]
  route       Route?   @relation(fields: [routeId], references: [id])
  routeId     String?
  crews       Crew[]
  shipments   Shipment[]
}

model Crew {
  id        String   @id @default(uuid())
  name      String
  position  String
  vessel    Vessel?  @relation(fields: [vesselId], references: [id])
  vesselId  String?
  
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @unique
}

model Log {
  id        String   @id @default(cuid())
  vesselId  String
  vessel    Vessel   @relation(fields: [vesselId], references: [id])
  fuelLevel Int
  speed     Float
  lat       Float
  lng       Float
  incident  String?
  timestamp DateTime @default(now())
}

enum Role {
  CUSTOMER
  MONITORING
  ADMIN
  CREW
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(CUSTOMER)
  
  // Verification fields
  isVerified              Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  
  crew      Crew?
  
  shipments Shipment[] @relation("CustomerShipments")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Shipment {
  id           String   @id // Tracking ID / Resi (Custom Format: PFXXXXXX)
  title        String
  description  String?

  // Pengirim & Penerima
  senderName   String   @default("")
  receiverName String   @default("")
  phone        String   @default("")

  // Pengiriman
  sendDate     DateTime @default(now())
  weight       Float
  volume       Float?
  type         String   // FCL, LCL
  deliveryType String   @default("BIASA") // BIASA, CEPAT, VVIP
  origin       String
  destination  String
  status       String   // PENDING, APPROVED, IN_TRANSIT, ARRIVED, REJECTED
  cost         Float?
  paymentMethod String   @default("TRANSFER_BANK") // TRANSFER_BANK, COD, E_WALLET
  paymentStatus String   @default("UNPAID")        // UNPAID, PAID


  customerId   String
  customer     User     @relation("CustomerShipments", fields: [customerId], references: [id])

  vesselId     String?
  vessel       Vessel?  @relation(fields: [vesselId], references: [id])

  events       TrackingEvent[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  location    String
  status      String
  description String?
  timestamp   DateTime @default(now())
}
